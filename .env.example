# Application (nginx :3131 → backend :3131)
GO_ENV=production
PORT=3131
DB_MAX_POOL=5

# CORS — frontend di Vercel (HTTPS) memanggil API di VPS
# Pisahkan dengan koma. Contoh production + staging:
# CORS_ORIGINS=https://progas-wms.vercel.app,https://app.progas.co.id
CORS_ORIGINS=
# true = izinkan semua *.vercel.app (preview deploy)
CORS_ALLOW_VERCEL_PREVIEW=true

# JWT
AUTH_TOKEN_EXPIRED_IN_MINUTES=15
REFRESH_TOKEN_EXPIRED_IN_DAYS=7
AUTH_TOKEN_SECRET_KEY=change-me-access-secret-min-32-chars
REFRESH_TOKEN_SECRET_KEY=change-me-refresh-secret-min-32-chars

# --- MySQL native di VPS (bukan container Docker) ---
# Backend container connect lewat host.docker.internal (lihat extra_hosts di docker-compose.yml)
MYSQL_DATABASE=progas_wms
MYSQL_USER=progas_app
MYSQL_PASSWORD=change-me-app-password
MYSQL_PORT=3306

DB_URL=progas_app:change-me-app-password@tcp(host.docker.internal:3306)/progas_wms?charset=utf8mb4&parseTime=True&loc=Local

# --- Cloud MySQL (Aiven, dll.) — ganti host:port di DB_URL ---
# DB_URL=user:pass@tcp(host:3306)/dbname?charset=utf8mb4&parseTime=True&loc=Local&tls=skip-verify
